FROM python:3.13-slim

WORKDIR /app

RUN apt-get update -qq && \
    apt-get install -y -qq ffmpeg build-essential curl git && \
    rm -rf /var/lib/apt/lists/*

COPY backend/pyproject.toml backend/
COPY backend/app backend/app
COPY worker worker

RUN pip install --no-cache-dir -e backend/

# Install Sanas wheel from livekit-agent-worker mount at runtime
ENV LIVEKIT_WORKER_ROOT=/livekit-worker
ENV NC_WER_DATA_DIR=/app/data

CMD ["bash", "-lc", "pip install -q /livekit-worker/sdk/sanas/sanas_remote_sdk-*.whl && python worker/benchmark_nc_wer.py --help"]
