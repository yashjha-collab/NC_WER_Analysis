# Backend
NC_WER_HOST=0.0.0.0
NC_WER_PORT=8080
NC_WER_DATA_DIR=./data
NC_WER_DATABASE_URL=sqlite+aiosqlite:///./data/nc_wer.db
NC_WER_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Path to livekit-agent-worker for NC engines (REQUIRED for tier_a: dtln/hush/hecttor)
# Example: /Users/you/Desktop/livekit-agent-worker
LIVEKIT_WORKER_ROOT=

# STT (at least one required for benchmarks)
DEEPGRAM_API_KEY=
CARTESIA_API_KEY=
SARVAM_API_KEY=

# Google Chirp STT (service account JSON as a single line, or reuse GCS JSON)
GOOGLE_SERVICE_ACCOUNT_JSON=
GOOGLE_CLOUD_PROJECT=
GOOGLE_STT_LOCATION=us

# NC cloud credentials (optional — only needed for hecttor/sanas)
HECTTOR_API_KEY=
SANAS_ENDPOINT=
SANAS_ACCOUNT_ID=
SANAS_ACCOUNT_SECRET=
SANAS_SECURE_MEDIA=true

# Default benchmark settings
DEFAULT_STT_PROVIDER=deepgram
DEFAULT_STT_MODEL=nova-2
DEFAULT_STT_LANGUAGE=hi
DEFAULT_TURN_ALIGN=forced
# Scoring stack applied on every run: forced align + ITN + OI-WER lattice
# (cross-script consonant-skeleton fuzzy matching is built into both).
DEFAULT_SCORING=itn+oiwer
DEFAULT_NC_STRENGTH=0.5
DEFAULT_HUSH_STRENGTH=0.35
# Execution mode: server = ProcessPool + asyncio; local = single process
DEFAULT_EXECUTION_MODE=server

# Parallelism (multiprocessing workers + asyncio STT overlap)
# On n2-standard-16 use WORKER_PROCESSES=8 and WORKER_CPU_THREADS=2
WORKER_PROCESSES=8
WORKER_CPU_THREADS=2
STT_ASYNC_CONCURRENCY=4
